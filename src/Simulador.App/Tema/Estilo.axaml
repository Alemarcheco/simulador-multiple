<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Aspecto común de toda la aplicación (se aplica encima del tema Fluent a todos los simuladores).
    Paleta: fondo gris azulado muy claro, superficies blancas, acento azul y cabecera azul marino.
    Los lienzos de dibujo siguen siendo "papel" blanco, como en un plano.
  -->
  <Styles.Resources>
    <!-- Paleta propia (también la usa la ventana principal) -->
    <Color x:Key="SimAccentColor">#1F6FEB</Color>
    <SolidColorBrush x:Key="SimAccentBrush" Color="#1F6FEB" />
    <SolidColorBrush x:Key="SimAccentSoftBrush" Color="#E7F0FD" />
    <SolidColorBrush x:Key="SimWindowBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="SimSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SimLineBrush" Color="#D8DEE6" />
    <SolidColorBrush x:Key="SimInkBrush" Color="#1C2430" />
    <SolidColorBrush x:Key="SimMutedBrush" Color="#5B6675" />
    <SolidColorBrush x:Key="SimHeaderBrush" Color="#14213D" />
    <SolidColorBrush x:Key="SimHeaderLineBrush" Color="#24345A" />
    <SolidColorBrush x:Key="SimHeaderTextBrush" Color="#C9D3E3" />

    <!-- Esquinas y tamaños -->
    <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Thickness x:Key="ButtonPadding">10,4,10,5</Thickness>
    <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>
    <Thickness x:Key="ToggleButtonBorderThemeThickness">1</Thickness>
    <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

    <!-- Botones: blancos con borde fino, como una barra de herramientas profesional -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EEF3FB" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DCE7F8" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F1F3F6" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CDD5DF" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#8FB3EE" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1F6FEB" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#E1E5EA" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#1C2430" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0F4FB8" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#0F4FB8" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#9AA4B1" />

    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#EEF3FB" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#DCE7F8" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#F1F3F6" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#CDD5DF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#8FB3EE" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#1F6FEB" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#E1E5EA" />
    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#1C2430" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#0F4FB8" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#0F4FB8" />
    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#9AA4B1" />

    <!-- Cajas de texto y desplegables -->
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CDD5DF" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#8FB3EE" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CDD5DF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#8FB3EE" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFFFF" />

    <!-- Pestañas internas de cada simulador: compactas, con subrayado azul -->
    <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
    <x:Double x:Key="TabItemMinHeight">36</x:Double>
    <x:Double x:Key="TabItemVerticalPipeHeight">20</x:Double>
    <x:Double x:Key="TabItemPipeThickness">3</x:Double>
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#5B6675" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#1C2430" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed" Color="#1C2430" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#0F4FB8" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#0F4FB8" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="#0F4FB8" />
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#1F6FEB" />

    <!-- Barras de desplazamiento discretas -->
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#8C97A6" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource SimWindowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SimInkBrush}" />
  </Style>

  <!-- Las pestañas internas en negrita suave cuando están elegidas -->
  <Style Selector="TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===================== Cabecera de la ventana principal ===================== -->
  <Style Selector="TabControl.shell">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource SimHeaderBrush}"
                  BorderBrush="{StaticResource SimHeaderLineBrush}" BorderThickness="0,0,0,1">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="6,0" />
          </Border>
          <ContentPresenter Name="PART_SelectedContentHost"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabControl.shell > TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource SimHeaderTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Chip" Background="Transparent" Padding="{TemplateBinding Padding}" Height="38"
                BorderThickness="0,0,0,3" BorderBrush="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" VerticalAlignment="Center"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.shell > TabItem:pointerover /template/ Border#PART_Chip">
    <Setter Property="Background" Value="#1D2D50" />
  </Style>
  <Style Selector="TabControl.shell > TabItem:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TabControl.shell > TabItem:selected">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabControl.shell > TabItem:selected /template/ Border#PART_Chip">
    <Setter Property="Background" Value="#22365F" />
    <Setter Property="BorderBrush" Value="#4C8DFF" />
  </Style>

  <!-- ===================== Barra de menús (Archivo, Editar…) ===================== -->
  <Style Selector="Border.menubar">
    <Setter Property="Background" Value="#0F1A31" />
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="Border.menubar Menu">
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.menubar Menu > MenuItem">
    <Setter Property="Foreground" Value="{StaticResource SimHeaderTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="Border.menubar Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#22365F" />
  </Style>
  <Style Selector="Border.menubar Menu > MenuItem:open /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#22365F" />
  </Style>
  <Style Selector="Border.menubar Menu > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.menubar Menu > MenuItem:open /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Los submenús vuelven al aspecto claro normal -->
  <Style Selector="Border.menubar Menu MenuItem MenuItem">
    <Setter Property="Foreground" Value="{StaticResource SimInkBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ===================== Barra de estado ===================== -->
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="#E9EDF2" />
    <Setter Property="BorderBrush" Value="{StaticResource SimLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource SimMutedBrush}" />
  </Style>

  <!-- ===================== Pantalla de inicio ===================== -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="{StaticResource SimSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SimLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="Width" Value="300" />
    <Setter Property="Height" Value="128" />
    <Setter Property="Margin" Value="0,0,16,16" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F7FAFF" />
    <Setter Property="BorderBrush" Value="#1F6FEB" />
  </Style>
  <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#EAF2FF" />
  </Style>
</Styles>
