<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ventana principal: carga los módulos y muestra cada simulador en una pestaña. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Simulador.App</RootNamespace>
    <AssemblyName>SimuladorMultiple</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Simulador.Core\Simulador.Core.csproj" />
    <!-- Módulos: añade aquí la referencia a tu proyecto Simulador.<Nombre> para que se copie junto al ejecutable. -->
    <ProjectReference Include="..\Simulador.Circuitos\Simulador.Circuitos.csproj" />
    <ProjectReference Include="..\Simulador.Plc\Simulador.Plc.csproj" />
    <ProjectReference Include="..\Simulador.Civil\Simulador.Civil.csproj" />
    <ProjectReference Include="..\Simulador.Hidraulica\Simulador.Hidraulica.csproj" />
    <ProjectReference Include="..\Simulador.Electrico\Simulador.Electrico.csproj" />
  </ItemGroup>
</Project>
