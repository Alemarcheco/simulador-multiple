(footprint "Rele_SRD" (layer "F.Cu")
  (descr "Relé tipo SRD-05VDC (cubo de 19 x 15 mm): 1 común, 2-3 bobina, 4 NC, 5 NA. Comprueba las medidas con tu relé.")
  (tags "rele relay SRD THT")
  (attr through_hole)
  (fp_line (start -2 -7.6) (end 17.1 -7.6) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 17.1 -7.6) (end 17.1 7.6) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 17.1 7.6) (end -2 7.6) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -2 7.6) (end -2 -7.6) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (pad "1" thru_hole rect (at 0 0) (size 2.6 2.6) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2 -6) (size 2.6 2.6) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2 6) (size 2.6 2.6) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 14.2 -6) (size 2.6 2.6) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 14.2 6) (size 2.6 2.6) (drill 1.3) (layers "*.Cu" "*.Mask")))
