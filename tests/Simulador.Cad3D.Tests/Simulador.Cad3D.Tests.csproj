<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <!-- Biblioteca nativa de Skia para ejecutar las pruebas de texto en Linux (en la app la trae Avalonia). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- USDZ de prueba hecho con usd-core (Datos/generar-pieza-usdz.py), como los que crea el iPhone. -->
    <None Include="Datos\*.usdz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Simulador.Core\Simulador.Core.csproj" />
    <ProjectReference Include="..\..\src\Simulador.Cad3D.Geometry\Simulador.Cad3D.Geometry.csproj" />
    <ProjectReference Include="..\..\src\Simulador.Circuitos\Simulador.Circuitos.csproj" />
    <ProjectReference Include="..\..\src\Simulador.Cad3D\Simulador.Cad3D.csproj" />
  </ItemGroup>
</Project>
