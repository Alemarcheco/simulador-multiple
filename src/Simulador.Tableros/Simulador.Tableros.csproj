       canaletas, aparamenta, borneras, cableado, listas de materiales y vista 3D) a partir del esquema eléctrico. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Simulador.Tableros</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Simulador.Core\Simulador.Core.csproj" />
    <ProjectReference Include="..\Simulador.Electrico.Engine\Simulador.Electrico.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Simulador.Tableros.Tests" />
  </ItemGroup>
</Project>
