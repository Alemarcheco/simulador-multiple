(footprint "TO-92_Inline" (layer "F.Cu")
  (descr "Transistor TO-92 en línea, separación 2,54 mm (2N2222/2N3906: 1 = E, 2 = B, 3 = C)")
  (tags "TO-92 transistor THT")
  (attr through_hole)
  (fp_line (start -0.53 1.85) (end 5.61 1.85) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_arc (start -0.53 1.85) (mid 2.54 -2.6) (end 5.61 1.85) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (pad "1" thru_hole rect (at 0 0) (size 1.6 2.0) (drill 0.8) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole oval (at 2.54 0) (size 1.6 2.0) (drill 0.8) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole oval (at 5.08 0) (size 1.6 2.0) (drill 0.8) (layers "*.Cu" "*.Mask")))
